# Railway Environment Variables
PORT=3000

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://galaktik-uzay-seo-otomasyonu-production.up.railway.app/auth/callback
GOOGLE_SCOPE=https://www.googleapis.com/auth/webmasters https://www.googleapis.com/auth/indexing
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email (opsiyonel)
SENDER_EMAIL=your_sender_email_here
RECEIVER_EMAIL=your_receiver_email_here

# Sitemap Configuration
SITEMAP_INDEX_URL=https://galaktikuzay.com/sitemap_index.xml
SITE_URL=https://galaktikuzay.com/

# JSONBin.io Configuration (Ücretsiz JSON Storage)
# 1. https://jsonbin.io/ adresine git
# 2. Ücretsiz hesap oluştur
# 3. Yeni bin oluştur
# 4. API Key ve Bin ID'yi al
JSONBIN_API_KEY=your_jsonbin_api_key_here
JSONBIN_BIN_ID=your_jsonbin_bin_id_here

# Railway Persistent Storage (Opsiyonel - ücretli olabilir)
# Railway dashboard → Settings → Persistent Storage
RAILWAY_VOLUME_MOUNT_PATH=/data
